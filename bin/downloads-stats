#!/usr/bin/env bash
# Print {"bytes": N, "count": M} as JSON for a folder (recursive, matching
# the folder-totals hero in the panel).
#
# Excludes dotfiles and dot-directories to match the FolderListModel in
# Service.qml (showHidden: false) — otherwise the hero total silently
# disagrees with what the panel's list can ever show. A single `find` pass
# (rather than a separate `du` and `find`) also halves the directory
# traversals this does, which matters because it runs on a timer while a
# download is in progress.
#
# `-name '.*' -prune` matches each entry's own name, so only entries hidden
# *below* the watched folder are skipped. A `-path '*/.*'` test would match
# against the whole path instead and exclude everything under a folder that
# is itself inside a dot-directory (~/.local/share/downloads, a Syncthing
# tree), reporting zero over a list the panel still shows. Pruning also stops
# find from descending into hidden directories at all.
#
# `-mindepth 1` keeps the watched folder itself out of that name test —
# without it, pointing the plugin at a hidden folder (~/.downloads) prunes
# the search at its own root and reports zero.
#
# This runs on a timer from the long-lived shell process (Service.qml), so a
# huge or adversarial tree under the watched folder must not be able to keep
# it busy indefinitely: MAX_DEPTH bounds how far find recurses, MAX_FILES
# bounds how many files get counted (past that many, bytes/count become a
# floor rather than an exact total — `head` closing early also stops `find`
# from walking any further once the cap is hit), and DEADLINE is a hard
# wall-clock backstop in case a slow/huge/network-mounted tree still
# outruns those. `|| true` on the inner pipeline keeps a `head`-induced
# SIGPIPE or a `timeout` kill from tripping `set -e` on this line — a
# partial count from whatever was piped through before the cutoff is the
# intended degraded result, not a script failure.
set -euo pipefail

MAX_DEPTH=20
MAX_FILES=20000
DEADLINE=10

dir="${1:?usage: downloads-stats <folder>}"
[[ -d "$dir" ]] || { echo "downloads-stats: no such folder: $dir" >&2; exit 1; }

read -r bytes count < <(
  { timeout "$DEADLINE" find "$dir" -maxdepth "$MAX_DEPTH" -mindepth 1 -name '.*' -prune -o -type f -printf '%s\n' |
    head -n "$MAX_FILES" |
    awk '{ sum += $1; n++ } END { printf "%d %d\n", sum+0, n+0 }'; } || true
)

printf '{"bytes": %s, "count": %s}\n' "${bytes:-0}" "${count:-0}"
