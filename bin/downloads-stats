#!/usr/bin/env bash
# Print {"bytes": N, "count": M} as JSON for a folder (recursive, matching
# the folder-totals hero in the panel).
#
# Excludes dotfiles and dot-directories to match the FolderListModel in
# Service.qml (showHidden: false) — otherwise the hero total silently
# disagrees with what the panel's list can ever show. A single `find` pass
# (rather than a separate `du` and `find`) also halves the directory
# traversals this does, which matters because it runs on a timer while a
# download is in progress.
set -euo pipefail

dir="${1:?usage: downloads-stats <folder>}"
[[ -d "$dir" ]] || { echo "downloads-stats: no such folder: $dir" >&2; exit 1; }

read -r bytes count < <(
  find "$dir" -type f -not -path '*/.*' -printf '%s\n' |
    awk '{ sum += $1; n++ } END { printf "%d %d\n", sum, n }'
)

printf '{"bytes": %s, "count": %s}\n' "$bytes" "$count"
