#!/usr/bin/env bash
# Print {"bytes": N, "count": M} for a folder (recursive). Used by Service.qml
# for the header totals; JSON keeps the QML side a one-line JSON.parse.
set -euo pipefail

dir="${1:?usage: downloads-stats <folder>}"
[[ -d "$dir" ]] || { echo "downloads-stats: no such folder: $dir" >&2; exit 1; }

bytes="$(du -sb -- "$dir" | cut -f1)"
count="$(find "$dir" -type f | wc -l)"

printf '{"bytes": %s, "count": %s}\n' "$bytes" "$count"
