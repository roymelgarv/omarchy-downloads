#!/usr/bin/env bash
# Copy a file to the Wayland clipboard as text/uri-list, so it can be pasted
# into file managers, browsers, and chat apps. --print-uri prints the encoded
# URI instead of copying (used by the test suite, which has no compositor).
set -euo pipefail

# shellcheck source=lib.sh
source "$(cd "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

print_only=false
if [[ "${1:-}" == "--print-uri" ]]; then
  print_only=true
  shift
fi

file="${1:?usage: downloads-copy [--print-uri] <file>}"
[[ -e "$file" ]] || { echo "downloads-copy: no such file: $file" >&2; exit 1; }

abs="$(abs_path "$file")"
uri="file://$(uri_encode_path "$abs")"

if $print_only; then
  printf '%s\n' "$uri"
  exit 0
fi

printf '%s' "$uri" | wl-copy --type text/uri-list
